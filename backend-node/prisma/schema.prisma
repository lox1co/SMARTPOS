generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id          String   @id @db.VarChar(100)
  name        String   @db.VarChar(255)
  category    String   @db.VarChar(100)
  phone       String   @db.VarChar(50)
  email       String?  @db.VarChar(255)
  gstNumber   String?  @map("gst_number") @db.VarChar(100)
  address     String?
  taxEnabled  Boolean  @default(true) @map("tax_enabled")
  taxRate     Decimal? @default(8.00) @map("tax_rate") @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  users       User[]
  products    Product[]
  transactions Transaction[]
  customers   Customer[]
  creditEntries CreditEntry[]

  @@map("stores")
}

model User {
  id              Int      @id @default(autoincrement())
  storeId         String   @map("store_id") @db.VarChar(100)
  name            String   @db.VarChar(255)
  emailOrUsername String   @unique @map("email_or_username") @db.VarChar(255)
  password        String   @db.VarChar(255)
  role            String   @default("cashier") @db.VarChar(50)
  phone           String?  @db.VarChar(50)
  image           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  transactions    Transaction[]

  @@index([storeId])
  @@map("users")
}

model Product {
  id            Int      @id @default(autoincrement())
  storeId       String   @map("store_id") @db.VarChar(100)
  name          String   @db.VarChar(255)
  sku           String   @db.VarChar(100)
  price         Decimal  @db.Decimal(10, 2)
  costPrice     Decimal  @map("cost_price") @db.Decimal(10, 2)
  stock         Decimal  @default(0) @db.Decimal(10, 3)
  lowStockAlert Decimal  @default(5) @map("low_stock_alert") @db.Decimal(10, 3)
  category      String   @db.VarChar(100)
  unit          String?  @default("pcs") @db.VarChar(50)
  taxRate       Decimal  @default(8.00) @map("tax_rate") @db.Decimal(5, 2)
  image         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  transactionItems TransactionItem[]

  @@unique([storeId, sku], map: "unique_store_sku")
  @@index([storeId, isActive])
  @@map("products")
}

model Transaction {
  storeId       String   @map("store_id") @db.VarChar(100)
  invoiceNumber String   @map("invoice_number") @db.VarChar(100)
  userId        Int?     @map("user_id")
  customerId    Int?     @map("customer_id")
  customerName  String?  @map("customer_name") @db.VarChar(255)
  customerPhone String?  @map("customer_phone") @db.VarChar(50)
  paymentMethod String   @default("CASH") @map("payment_method") @db.VarChar(50)
  paymentStatus String   @default("PAID") @map("payment_status") @db.VarChar(50)
  subtotal      Decimal  @db.Decimal(10, 2)
  discount      Decimal  @default(0) @db.Decimal(10, 2)
  tax           Decimal  @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cashier       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         TransactionItem[]

  @@id([storeId, invoiceNumber])
  @@index([storeId, createdAt])
  @@map("transactions")
}

model TransactionItem {
  id            Int      @id @default(autoincrement())
  storeId       String   @map("store_id") @db.VarChar(100)
  invoiceNumber String   @map("invoice_number") @db.VarChar(100)
  productId     Int?     @map("product_id")
  productName   String   @map("product_name") @db.VarChar(255)
  quantity      Decimal  @db.Decimal(10, 3)
  price         Decimal  @db.Decimal(10, 2)
  transaction   Transaction @relation(fields: [storeId, invoiceNumber], references: [storeId, invoiceNumber], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([storeId, invoiceNumber])
  @@map("transaction_items")
}

model Customer {
  id            Int      @id @default(autoincrement())
  storeId       String   @map("store_id") @db.VarChar(100)
  name          String   @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  creditBalance Decimal  @default(0) @map("credit_balance") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  entries       CreditEntry[]
  transactions  Transaction[]

  @@unique([storeId, name], map: "unique_store_customer_name")
  @@index([storeId])
  @@map("customers")
}

model CreditEntry {
  id            Int      @id @default(autoincrement())
  storeId       String   @map("store_id") @db.VarChar(100)
  customerId    Int      @map("customer_id")
  entryType     String   @map("entry_type") @db.VarChar(10)
  amount        Decimal  @db.Decimal(10, 2)
  note          String?
  invoiceNumber String?  @map("invoice_number") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("credit_entries")
}